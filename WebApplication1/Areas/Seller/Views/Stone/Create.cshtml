                        item.type = 'button';
                        item.dataset.value = option.value;
                        item.dataset.name = option.textContent.trim();

                        item.className =
                            'block w-full rounded-lg px-3 py-2.5 text-right text-sm ' +
                            'text-gray-700 transition hover:bg-indigo-50 ' +
                            'focus:outline-none focus:bg-indigo-50 ' +
                            'dark:text-gray-200 dark:hover:bg-gray-700 ' +
                            'dark:focus:bg-gray-700';

                        item.textContent = option.textContent.trim();
                        item.setAttribute('role', 'option');
                        item.setAttribute('aria-selected', 'false');

                        item.addEventListener('click', () => {
                            select.value = item.dataset.value;
                            select.dispatchEvent(
                                new Event('change', { bubbles: true })
                            );

                            updateSelectedOption();
                            closeDropdown();
                        });

                        optionsContainer.appendChild(item);
                    });

                filterOptions();
                updateSelectedOption();
            }

            function updateSelectedOption() {
                const selectedOption = select.options[select.selectedIndex];

                dropdownLabel.textContent =
                    selectedOption && selectedOption.value !== ''
                        ? selectedOption.textContent.trim()
                        : 'انتخاب استان';

                optionsContainer.querySelectorAll('[role="option"]').forEach(item => {
                    const isSelected = item.dataset.value === select.value;

                    item.setAttribute(
                        'aria-selected',
                        isSelected ? 'true' : 'false'
                    );

                    item.classList.toggle('bg-indigo-50', isSelected);
                    item.classList.toggle('font-semibold', isSelected);
                    item.classList.toggle('dark:bg-gray-700', isSelected);
                });
            }

            function openDropdown() {
                dropdownMenu.classList.remove('hidden');

                dropdownButton.setAttribute('aria-expanded', 'true');
                dropdownArrow.classList.add('rotate-180');

                searchInput.value = '';
                filterOptions();
                searchInput.focus();
            }

            function closeDropdown() {
                dropdownMenu.classList.add('hidden');

                dropdownButton.setAttribute('aria-expanded', 'false');
                dropdownArrow.classList.remove('rotate-180');
            }

            function filterOptions() {
                const searchTerm = searchInput.value
                    .trim()
                    .toLocaleLowerCase('fa-IR');

                let visibleCount = 0;

                optionsContainer.querySelectorAll('[role="option"]').forEach(item => {
                    const name = item.dataset.name.toLocaleLowerCase('fa-IR');
                    const matches = name.includes(searchTerm);

                    item.classList.toggle('hidden', !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                noResults.classList.toggle('hidden', visibleCount > 0);
            }

            dropdownButton.addEventListener('click', () => {
                if (dropdownMenu.classList.contains('hidden')) {
                    openDropdown();
                } else {
                    closeDropdown();
                }
            });

            searchInput.addEventListener('input', filterOptions);

            document.addEventListener('click', event => {
                if (
                    !dropdownMenu.contains(event.target) &&
                    !dropdownButton.contains(event.target)
                ) {
                    closeDropdown();
                }
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeDropdown();
                }
            });

            select.addEventListener('change', updateSelectedOption);

            renderOptions();
        })();
         // Location Custom Dropdown
        (() => {
            const select = document.getElementById('locationSelect');
            const dropdownButton = document.getElementById('locationDropdownButton');
            const dropdownMenu = document.getElementById('locationDropdownMenu');
            const dropdownLabel = document.getElementById('locationDropdownLabel');
            const dropdownArrow = document.getElementById('locationDropdownArrow');
            const optionsContainer = document.getElementById('locationOptions');

            if (
                !select ||
                !dropdownButton ||
                !dropdownMenu ||
                !dropdownLabel ||
                !dropdownArrow ||
                !optionsContainer
            ) {
                return;
            }

            function updateSelectedOption() {
                const selectedOption = select.options[select.selectedIndex];

                dropdownLabel.textContent =
                    selectedOption && selectedOption.value !== ''
                        ? selectedOption.textContent.trim()
                        : 'انتخاب محل';

                optionsContainer.querySelectorAll('[role="option"]').forEach(item => {
                    const isSelected = item.dataset.value === select.value;

                    item.setAttribute(
                        'aria-selected',
                        isSelected ? 'true' : 'false'
                    );

                    item.classList.toggle('bg-indigo-50', isSelected);
                    item.classList.toggle('font-semibold', isSelected);
                    item.classList.toggle('dark:bg-gray-700', isSelected);
                });
            }

            function openDropdown() {
                dropdownMenu.classList.remove('hidden');
                dropdownButton.setAttribute('aria-expanded', 'true');
                dropdownArrow.classList.add('rotate-180');
            }

            function closeDropdown() {
                dropdownMenu.classList.add('hidden');
                dropdownButton.setAttribute('aria-expanded', 'false');
                dropdownArrow.classList.remove('rotate-180');
            }

            optionsContainer.querySelectorAll('[role="option"]').forEach(item => {
                item.addEventListener('click', () => {
                    select.value = item.dataset.value;

                    select.dispatchEvent(
                        new Event('change', { bubbles: true })
                    );

                    updateSelectedOption();
                    closeDropdown();
                });
            });

            dropdownButton.addEventListener('click', () => {
                if (dropdownMenu.classList.contains('hidden')) {
                    openDropdown();
                } else {
                    closeDropdown();
                }
            });

            document.addEventListener('click', event => {
                if (
                    !dropdownMenu.contains(event.target) &&
                    !dropdownButton.contains(event.target)
                ) {
                    closeDropdown();
                }
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeDropdown();
                }
            });

            select.addEventListener('change', updateSelectedOption);

            updateSelectedOption();
        })();
        //Images
        (() => {
            const imageInput = document.getElementById('Images');
            const previewContainer = document.getElementById('imagePreviewContainer');
            const previewList = document.getElementById('imagePreviewList');
            const imageCount = document.getElementById('imageCount');

            if (!imageInput || !previewContainer || !previewList) return;

            let selectedFiles = [];

            imageInput.addEventListener('change', () => {
                selectedFiles = Array.from(imageInput.files)
                    .filter(file => file.type.startsWith('image/'));

                renderPreviews();
            });

            function renderPreviews() {
                previewList.replaceChildren();

                if (selectedFiles.length === 0) {
                    previewContainer.classList.add('hidden');
                    return;
                }

                previewContainer.classList.remove('hidden');


        selectedFiles.forEach((file, index) => {
            const card = document.createElement('div');

            card.style.cssText = `
                position: relative;
                width: 96px;
                height: 96px;
                flex-shrink: 0;
                border-radius: 12px;
                overflow: visible;
            `;

            const image = document.createElement('img');
            image.src = URL.createObjectURL(file);
            image.alt = file.name;

            image.style.cssText = `
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 12px;
                border: 1px solid #d1d5db;
                display: block;
            `;

            image.onload = () => URL.revokeObjectURL(image.src);

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.textContent = '×';
            removeButton.title = 'حذف تصویر';
            removeButton.setAttribute('aria-label', 'حذف تصویر');

            removeButton.style.cssText = `
                position: absolute;
                top: -8px;
                right: -8px;
                z-index: 9999;
                width: 28px;
                height: 28px;
                padding: 0;
                border: 2px solid white;
                border-radius: 50%;
                background: #dc2626;
                color: white;
                font-size: 23px;
                font-weight: bold;
                line-height: 22px;
                text-align: center;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 2px 6px rgba(0,0,0,0.3);
            `;

            removeButton.addEventListener('click', () => {
                selectedFiles.splice(index, 1);
                updateInputFiles();
                renderPreviews();
            });

            card.appendChild(image);
            card.appendChild(removeButton);
            previewList.appendChild(card);
        });


                imageCount.textContent =
                    `${selectedFiles.length} تصویر انتخاب شده است`;
            }

            function updateInputFiles() {
                const dataTransfer = new DataTransfer();

                selectedFiles.forEach(file => dataTransfer.items.add(file));

                imageInput.files = dataTransfer.files;
            }
        })();
    </script>
}
