                                <!-- Scrollable options -->
                                <div id="applicationOptionsList"
                                     class="max-h-52 overflow-y-auto overscroll-contain p-2">

                                    @foreach (var item in Model.StoneApplications)
                                    {
                                        var isSelected =
                                        Model.ApplicationIds?.Contains(item.Id) == true;

                                        <label data-application-option
                                               data-application-name="@item.Name"
                                               class="flex cursor-pointer items-center gap-3
                                  rounded-lg px-3 py-2.5 text-sm
                                  text-gray-700 hover:bg-gray-100
                                  dark:text-gray-200 dark:hover:bg-gray-700">

                                            <input type="checkbox"
                                                   data-application-checkbox
                                                   data-application-id="@item.Id"
                                                   data-application-name="@item.Name"
                                                   value="@item.Id"
                                                   checked="@isSelected"
