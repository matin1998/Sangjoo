@model Sangjoo.Application.DTOs.AdminSide.Stones.StoneDTO

@{
    ViewData["Title"] = "افزودن سنگ جدید";
}

<div class="lg:col-span-3 space-y-8">

    <!-- Header -->
    <div class="bg-white rounded-2xl drop-shadow-lg p-6 dark:bg-custom-dark dark:border dark:border-gray-700">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between">

            <div>
                <h1 class="font-black text-2xl with-highlight dark:text-gray-200">
                    افزودن سنگ جدید
                </h1>

                <p class="text-gray-600 dark:text-gray-400 mt-1">
                    اطلاعات سنگ جدید را وارد کنید
                </p>
            </div>

            <div class="mt-4 md:mt-0 flex space-x-3">

                <button type="submit"
                        form="stoneForm"
                        class="bg-primary text-white py-2.5 px-4 rounded-lg
                               hover:bg-primary-600 active:scale-95 transition
                               duration-200 shadow-sm hover:shadow flex items-center">

                    <svg class="w-5 h-5 me-2"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7">
                        </path>

                    </svg>

                    ذخیره سنگ
                </button>

                <a asp-area="Seller"
                   asp-controller="Stone"
                   asp-action="Index"
                   class="bg-white border border-gray-300 text-gray-700
                          py-2.5 px-4 rounded-lg hover:bg-gray-50
                          active:scale-95 transition duration-200 shadow-sm
                          flex items-center dark:bg-gray-800
                          dark:border-gray-600 dark:text-gray-300">

                    <svg class="w-5 h-5 me-2"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M6 18L18 6M6 6l12 12">
                        </path>

                    </svg>

                    انصراف
                </a>

            </div>
        </div>
    </div>

    @if (ViewData["ValidationError"] is string errorMessage)
    {
        <script>
            alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)));
        </script>
    }
    <!-- Form -->
    <form id="stoneForm"
          asp-area="Seller"
          asp-controller="Stone"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Main Form -->
            <div class="lg:col-span-2 space-y-8">

                <!-- Basic Information -->
                <div class="bg-white rounded-2xl drop-shadow-lg p-6
                            dark:bg-custom-dark dark:border dark:border-gray-700">

                    <h2 class="font-black text-xl with-highlight
                               dark:text-gray-200 mb-6">
                        اطلاعات اصلی سنگ
                    </h2>

                    <div asp-validation-summary="ModelOnly"
                         class="mb-6 text-red-500 text-sm">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Stone Type -->
                        <div>
                            <label asp-for="StoneTypeId"
                                   class="mb-2 block text-sm font-medium
                  text-gray-700 dark:text-gray-300">
                                نوع سنگ
                                <span class="text-red-500">*</span>
                            </label>

                            <div class="flex gap-2">

                                <!-- Original select: retained for MVC model binding -->
                                <select asp-for="StoneTypeId"
                                        id="stoneTypeSelect"
                                        tabindex="-1"
                                        aria-hidden="true"
                                        class="absolute h-px w-px overflow-hidden opacity-0">
                                    <option value="">انتخاب نوع سنگ</option>

                                    @foreach (var item in Model.Types)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>

                                <!-- Custom dropdown -->
                                <div id="stoneTypeDropdown" class="relative min-w-0 flex-1">

                                    <!-- Trigger -->
                                    <button type="button"
                                            id="stoneTypeDropdownButton"
                                            aria-haspopup="listbox"
                                            aria-expanded="false"
                                            aria-controls="stoneTypeDropdownMenu"
                                            class="flex w-full items-center justify-between gap-3
                           rounded-lg border border-slate-300
                           bg-white px-4 py-2.5 text-sm text-gray-700
                           transition
                           hover:border-indigo-400
                           focus:outline-none focus:ring-2
                           focus:ring-indigo-300
                           dark:border-gray-600 dark:bg-gray-800
                           dark:text-white">

                                        <span id="stoneTypeDropdownLabel"
                                              class="truncate">
                                            انتخاب نوع سنگ
                                        </span>

                                        <svg id="stoneTypeDropdownArrow"
                                             class="h-5 w-5 shrink-0 transition-transform"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="m19 9-7 7-7-7">
                                            </path>
                                        </svg>
                                    </button>

                                    <!-- Custom menu -->
                                    <div id="stoneTypeDropdownMenu"
                                         class="absolute right-0 top-full z-50 mt-2
                                                hidden w-64 max-w-full overflow-hidden
                                                rounded-xl border-2 border-indigo-400
                                                bg-white shadow-xl
                                                dark:border-indigo-500 dark:bg-gray-800">

                                        <!-- Search -->
                                        <div class="border-b border-indigo-200 p-3
                            dark:border-indigo-700">
                                            <input type="search"
                                                   id="stoneTypeSearch"
                                                   autocomplete="off"
                                                   placeholder="جست‌وجوی نوع سنگ..."
                                                   class="w-full rounded-lg border
                                  border-indigo-200 bg-gray-50
                                  px-3 py-2 text-sm text-gray-800
                                  outline-none focus:border-indigo-500
                                  focus:ring-1 focus:ring-indigo-500
                                  dark:border-gray-600
                                  dark:bg-gray-700 dark:text-white" />
                                        </div>

                                        <!-- Options generated from the original select -->
                                        <div id="stoneTypeOptions"
                                             role="listbox"
                                             aria-label="انواع سنگ"
                                             class="overflow-y-auto overscroll-contain p-2"
                                             style="max-height: 220px;">
                                        </div>

                                        <p id="stoneTypeNoResults"
                                           class="hidden px-3 py-4 text-center
                          text-sm text-gray-500
                          dark:text-gray-400">
                                            نوع سنگی پیدا نشد.
                                        </p>
                                    </div>
                                </div>

                                <!-- Existing add button -->
                                <button type="button"
                                        id="addStoneTypeBtn"
                                        class="shrink-0 rounded-lg bg-primary
                       px-4 py-2.5 text-white
                       transition hover:bg-primary-600">
                                    + افزودن
                                </button>
                            </div>

                            <span asp-validation-for="StoneTypeId"
                                  class="text-red-500 text-xs">
                            </span>
                        </div>


                        <!-- Commercial Name -->
                        <div>
                    <label asp-for="CommercialNameId"
           class="mb-2 block text-sm font-medium
                  text-gray-700 dark:text-gray-300">
        نام تجاری
                                <span class="text-red-500">*</span>
                   </label>

                    <div class="flex gap-2">

        <!-- Original select: retained for MVC model binding -->
        <select asp-for="CommercialNameId"
                id="commercialNameSelect"
                tabindex="-1"
                aria-hidden="true"
                class="absolute h-px w-px overflow-hidden opacity-0">

            <option value="">انتخاب نام تجاری</option>

            @foreach (var item in Model.CommercialNames)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </select>

        <!-- Custom dropdown -->
        <div id="commercialNameDropdown"
             class="relative min-w-0 flex-1">

            <!-- Trigger -->
            <button type="button"
                    id="commercialNameDropdownButton"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-controls="commercialNameDropdownMenu"
                    class="flex w-full items-center justify-between gap-3
                           rounded-lg border border-slate-300
                           bg-white px-4 py-2.5 text-sm text-gray-700
                           transition
                           hover:border-indigo-400
                           focus:outline-none focus:ring-2
                           focus:ring-indigo-300
                           dark:border-gray-600 dark:bg-gray-800
                           dark:text-white">

                <span id="commercialNameDropdownLabel"
                      class="truncate">
                    انتخاب نام تجاری
                </span>

                <svg id="commercialNameDropdownArrow"
                     class="h-5 w-5 shrink-0 transition-transform"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="m19 9-7 7-7-7">
                    </path>
                </svg>
            </button>

            <!-- Custom menu -->
            <div id="commercialNameDropdownMenu"
                 class="absolute right-0 top-full z-50 mt-2
                        hidden w-64 max-w-full overflow-hidden
                        rounded-xl border-2 border-indigo-400
                        bg-white shadow-xl
                        dark:border-indigo-500 dark:bg-gray-800">

                <!-- Search -->
                <div class="border-b border-indigo-200 p-3
                            dark:border-indigo-700">

                    <input type="search"
                           id="commercialNameSearch"
                           autocomplete="off"
                           placeholder="جست‌وجوی نام تجاری..."
                           class="w-full rounded-lg border
                                  border-indigo-200 bg-gray-50
                                  px-3 py-2 text-sm text-gray-800
                                  outline-none focus:border-indigo-500
                                  focus:ring-1 focus:ring-indigo-500
                                  dark:border-gray-600
                                  dark:bg-gray-700 dark:text-white" />
                </div>

                <!-- Options generated from the original select -->
                <div id="commercialNameOptions"
                     role="listbox"
                     aria-label="نام‌های تجاری"
                     class="max-h-56 overflow-y-auto p-2"
                     style="max-height: 220px;">
                </div>

                <p id="commercialNameNoResults"
                   class="hidden px-3 py-4 text-center
                          text-sm text-gray-500
                          dark:text-gray-400">
                    نام تجاری‌ای پیدا نشد.
                </p>
            </div>
        </div>

        <!-- Existing add button -->
        <button type="button"
                id="addCommercialNameBtn"
                class="shrink-0 rounded-lg bg-primary
                       px-4 py-2.5 text-white
                       transition hover:bg-primary-600">
            + افزودن
        </button>
    </div>

    <span asp-validation-for="CommercialNameId"
          class="text-red-500 text-xs">
    </span>
</div>

                        
                        
                        <!-- Colors -->
                        <div class="relative" id="colorMultiSelect">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                رنگ سنگ
                                <span class="text-red-500">*</span>
                            </label>

                            <!-- برچسب‌های رنگ انتخاب‌شده -->
                            <div id="selectedColorTags"
                                 class="flex flex-wrap gap-2 mb-2">
                            </div>

                            <!-- کادر بازشونده -->
                            <button type="button"
                                    id="colorDropdownButton"
                                    aria-expanded="false"
                                    aria-controls="colorDropdown"
                                    class="flex w-full items-center justify-between gap-3
                                           rounded-lg border-2 border-black
                                           bg-white px-4 py-2.5 text-sm text-gray-700
                                           transition hover:border-indigo-400
                                           focus:outline-none focus:ring-2
                                           focus:ring-indigo-300
                                           dark:border-gray-600 dark:bg-gray-800
                                           dark:text-white">

                                <span id="colorDropdownLabel">انتخاب رنگ‌ها</span>

                                <svg id="colorDropdownArrow"
                                     class="w-4 h-4 shrink-0 transition-transform"
                                     viewBox="0 0 20 20"
                                     fill="currentColor"
                                     aria-hidden="true">
                                    <path fill-rule="evenodd"
                                          d="M5.22 7.22a.75.75 0 0 1 1.06 0L10 10.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 8.28a.75.75 0 0 1 0-1.06Z"
                                          clip-rule="evenodd" />
                                </svg>
                            </button>

                            <!-- فهرست رنگ‌ها -->
                            <div id="colorDropdown"
                                 class="hidden absolute right-0 left-0 top-full mt-2 z-50
                                        rounded-xl border-2 border-indigo-400
                                        bg-white shadow-xl
                                        dark:border-indigo-500 dark:bg-gray-800">

                                <div class="p-3 border-b border-indigo-400 dark:border-gray-700">
                                    <input type="search"
                                           id="colorSearchInput"
                                           autocomplete="off"
                                           placeholder="جست‌وجوی رنگ..."
                                           class="w-full rounded-lg border border-indigo-200
                                                   bg-gray-50 px-3 py-2 text-sm text-gray-800
                                                   outline-none focus:border-indigo-500
                                                   focus:ring-1 focus:ring-indigo-500
                                                   dark:border-gray-600 dark:bg-gray-700
                                                   dark:text-white dark:placeholder-gray-400" />
                                </div>

                                <!-- فهرست قابل اسکرول -->
                                <div id="colorOptionsList"
                                     class="overflow-y-auto overscroll-contain p-2"
                                     style="max-height: 220px;">

                                    @foreach (var color in Model.Colors)
                                    {
                                        var isSelected = Model.ColorIds?.Contains(color.Id) == true;

                                        <label data-color-option
                                               data-color-name="@color.Name"
                                               class="flex cursor-pointer items-center gap-3 rounded-lg
                          px-3 py-2.5 text-sm text-gray-700
                          hover:bg-gray-100
                          dark:text-gray-200 dark:hover:bg-gray-700">

                                            <input type="checkbox"
                                                   data-color-checkbox
                                                   data-color-id="@color.Id"
                                                   value="@color.Id"
                                                   data-color-name="@color.Name"
                                                   checked="@isSelected"
                                                   class="h-4 w-4 shrink-0 rounded border-gray-300
                              text-blue-600 focus:ring-blue-500
                              dark:border-gray-500 dark:bg-gray-700" />

                                            <span>@color.Name</span>
                                        </label>
                                    }

                                    <p id="colorNoResults"
                                       class="hidden px-3 py-4 text-center text-sm text-gray-500
                                              dark:text-gray-400">
                                        رنگی با این نام پیدا نشد.
                                    </p>
                                </div>

                                <div class="flex items-center justify-between gap-3 border-t
                                            border-indigo-400 px-3 py-2 dark:border-gray-700">

                                    <span id="colorSelectedCount"
                                          class="text-xs text-gray-500 dark:text-gray-400">
                                        ۰ رنگ انتخاب شده
                                    </span>

                                    <button type="button"
                                            id="clearColorsButton"
                                            class="text-xs font-medium text-red-600 hover:text-red-700
                       dark:text-red-400">
                                        پاک کردن انتخاب‌ها
                                    </button>
                                </div>
                            </div>

                            <!-- شناسه‌های انتخاب‌شده توسط JavaScript با نام ColorIds ارسال می‌شوند -->
                            <div id="colorHiddenInputs"></div>

                            <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
                                می‌توانید چند رنگ را هم‌زمان انتخاب کنید.
                            </p>

                            <span asp-validation-for="ColorIds"
                                  class="text-red-500 text-xs"></span>
                        </div>
                        


                        
                        <!-- Thickness -->
                        <div>
                            <label asp-for="ThicknessId"
                                   class="mb-2 block text-sm font-medium
                  text-gray-700 dark:text-gray-300">
                                ضخامت
                                <span class="text-red-500">*</span>
                            </label>

                            <div class="flex gap-2">

                                <!-- Original select: retained for MVC model binding -->
                                <select asp-for="ThicknessId"
                                        id="thicknessSelect"
                                        tabindex="-1"
                                        aria-hidden="true"
                                        class="absolute h-px w-px overflow-hidden opacity-0">

                                    <option value="">انتخاب ضخامت</option>

                                    @foreach (var item in Model.Thicknesses)
                                    {
                                        <option value="@item.Id">
                                            @item.Value سانتی‌متر
                                        </option>
                                    }
                                </select>

                                <!-- Custom dropdown -->
                                <div id="thicknessDropdown"
                                     class="relative min-w-0 flex-1">

                                    <!-- Trigger -->
                                    <button type="button"
                                            id="thicknessDropdownButton"
                                            aria-haspopup="listbox"
                                            aria-expanded="false"
                                            aria-controls="thicknessDropdownMenu"
                                            class="flex w-full items-center justify-between gap-3
                           rounded-lg border border-slate-300
                           bg-white px-4 py-2.5 text-sm text-gray-700
                           transition
                           hover:border-indigo-400
                           focus:outline-none focus:ring-2
                           focus:ring-indigo-300
                           dark:border-gray-600 dark:bg-gray-800
                           dark:text-white">

                                        <span id="thicknessDropdownLabel"
                                              class="truncate">
                                            انتخاب ضخامت
                                        </span>

                                        <svg id="thicknessDropdownArrow"
                                             class="h-5 w-5 shrink-0 transition-transform"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="m19 9-7 7-7-7">
                                            </path>
                                        </svg>
                                    </button>

                                    <!-- Custom menu -->
                                    <div id="thicknessDropdownMenu"
                                         class="absolute right-0 top-full z-50 mt-2
                        hidden w-64 max-w-full overflow-hidden
                        rounded-xl border-2 border-indigo-400
                        bg-white shadow-xl
                        dark:border-indigo-500 dark:bg-gray-800">

                                        <!-- Search -->
                                        <div class="border-b border-indigo-200 p-3
                            dark:border-indigo-700">

                                            <input type="search"
                                                   id="thicknessSearch"
                                                   autocomplete="off"
                                                   placeholder="جست‌وجوی ضخامت..."
                                                   class="w-full rounded-lg border
                                  border-indigo-200 bg-gray-50
                                  px-3 py-2 text-sm text-gray-800
                                  outline-none focus:border-indigo-500
                                  focus:ring-1 focus:ring-indigo-500
                                  dark:border-gray-600
                                  dark:bg-gray-700 dark:text-white" />
                                        </div>

                                        <!-- Options generated from the original select -->
                                        <div id="thicknessOptions"
                                             role="listbox"
                                             aria-label="ضخامت‌ها"
                                             class="overflow-y-auto overscroll-contain p-2"
                                             style="max-height: 220px;">
                                        </div>

                                        <!-- No results -->
                                        <p id="thicknessNoResults"
                                           class="hidden px-3 py-4 text-center
                          text-sm text-gray-500
                          dark:text-gray-400">
                                            ضخامت موردنظر پیدا نشد.
                                        </p>
                                    </div>
                                </div>

                                <!-- Existing add button -->
                                <button type="button"
                                        id="addThicknessBtn"
                                        class="shrink-0 rounded-lg bg-primary
                       px-4 py-2.5 text-white
                       transition hover:bg-primary-600">
                                    + افزودن
                                </button>
                            </div>

                            <span asp-validation-for="ThicknessId"
                                  class="text-red-500 text-xs">
                            </span>
                        </div>
                        


                        
                        <!-- Dimensions -->
                        <div class="md:col-span-2">
                            <label class="mb-3 block text-sm font-medium
                  text-gray-700 dark:text-gray-300">
                                ابعاد سنگ (سانتی‌متر)
                                <span class="text-red-500">*</span>
                            </label>

                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                                <!-- Minimum Length -->
                                <div>
                                    <label asp-for="MinLength"
                                           class="mb-2 block text-sm text-gray-600 dark:text-gray-400">
                                        حداقل طول
                                    </label>

                                    <input asp-for="MinLength"
                                           type="number"
                                           step="1"
                                           placeholder="مثلاً 240"
                                           class="w-full rounded-lg border border-slate-300
                          bg-white px-4 py-2.5 text-sm text-gray-700
                          focus:border-indigo-500 focus:outline-none
                          focus:ring-2 focus:ring-indigo-300
                          dark:border-gray-600 dark:bg-gray-800
                          dark:text-white" />

                                    <span asp-validation-for="MinLength"
                                          class="text-xs text-red-500"></span>
                                </div>

                                <!-- Maximum Length -->
                                <div>
                                    <label asp-for="MaxLength"
                                           class="mb-2 block text-sm text-gray-600 dark:text-gray-400">
                                        حداکثر طول
                                    </label>

                                    <input asp-for="MaxLength"
                                           type="number"
                                           step="1"
                                           placeholder="مثلاً 320"
                                           class="w-full rounded-lg border border-slate-300
                          bg-white px-4 py-2.5 text-sm text-gray-700
                          focus:border-indigo-500 focus:outline-none
                          focus:ring-2 focus:ring-indigo-300
                          dark:border-gray-600 dark:bg-gray-800
                          dark:text-white" />

                                    <span asp-validation-for="MaxLength"
                                          class="text-xs text-red-500"></span>
                                </div>

                                <!-- Minimum Width -->
                                <div>
                                    <label asp-for="MinWidth"
                                           class="mb-2 block text-sm text-gray-600 dark:text-gray-400">
                                        حداقل عرض
                                    </label>

                                    <input asp-for="MinWidth"
                                           type="number"
                                           step="1"
                                           placeholder="مثلاً 120"
                                           class="w-full rounded-lg border border-slate-300
                          bg-white px-4 py-2.5 text-sm text-gray-700
                          focus:border-indigo-500 focus:outline-none
                          focus:ring-2 focus:ring-indigo-300
                          dark:border-gray-600 dark:bg-gray-800
                          dark:text-white" />

                                    <span asp-validation-for="MinWidth"
                                          class="text-xs text-red-500"></span>
                                </div>

                                <!-- Maximum Width -->
                                <div>
                                    <label asp-for="MaxWidth"
                                           class="mb-2 block text-sm text-gray-600 dark:text-gray-400">
                                        حداکثر عرض
                                    </label>

                                    <input asp-for="MaxWidth"
                                           type="number"
                                           step="1"
                                           placeholder="مثلاً 180"
                                           class="w-full rounded-lg border border-slate-300
                          bg-white px-4 py-2.5 text-sm text-gray-700
                          focus:border-indigo-500 focus:outline-none
                          focus:ring-2 focus:ring-indigo-300
                          dark:border-gray-600 dark:bg-gray-800
                          dark:text-white" />

                                    <span asp-validation-for="MaxWidth"
                                          class="text-xs text-red-500"></span>
                                </div>

                            </div>
                        </div>








                        <!-- Processing Types -->
                        <div class="relative" id="processingTypeMultiSelect">

                            <label asp-for="ProcessingTypeIds"
                                   class="mb-2 block text-sm font-medium
                  text-gray-700 dark:text-gray-300">
                                نوع فرآوری
                                <span class="text-red-500">*</span>
                            </label>

                            <!-- Selected processing type tags -->
                            <div id="selectedProcessingTypeTags"
                                 class="mb-2 flex flex-wrap gap-2">
                            </div>

                            <div class="flex items-start gap-2">

                                <!-- Multi-select trigger and menu -->
                                <div class="min-w-0 flex-1">

                                    <!-- Trigger -->
                                    <button type="button"
                                            id="processingTypeDropdownButton"
                                            aria-haspopup="listbox"
                                            aria-expanded="false"
                                            aria-controls="processingTypeDropdownMenu"
                                            class="flex w-full items-center justify-between gap-3
                           rounded-xl border border-slate-300 bg-white
                           px-4 py-3 text-right text-sm text-gray-700
                           shadow-sm transition hover:border-blue-400
                           focus:outline-none focus:ring-2 focus:ring-blue-500
