    <script>
        
        // Commercial Name Modal
        (() => {
    const addCommercialNameBtn =
        document.getElementById('addCommercialNameBtn');

    const commercialNameModal =
        document.getElementById('commercialNameModal');

    const cancelCommercialNameBtn =
        document.getElementById('cancelCommercialNameBtn');

    const closeCommercialNameModalBtn =
        document.getElementById('closeCommercialNameModalBtn');

    const saveCommercialNameBtn =
        document.getElementById('saveCommercialNameBtn');

    const newCommercialName =
        document.getElementById('newCommercialName');

    const commercialNameError =
        document.getElementById('commercialNameError');

    const commercialNameSelect =
        document.getElementById('commercialNameSelect');

    if (
        !addCommercialNameBtn ||
        !commercialNameModal ||
        !cancelCommercialNameBtn ||
        !saveCommercialNameBtn ||
        !newCommercialName ||
        !commercialNameError ||
        !commercialNameSelect
    ) {
        console.error(
            'عناصر موردنیاز مودال نام تجاری پیدا نشدند.'
        );
        return;
    }

    const clearError = () => {
        commercialNameError.textContent = '';
        commercialNameError.classList.add('hidden');
    };

    const closeModal = () => {
        commercialNameModal.classList.add('hidden');
        commercialNameModal.classList.remove('flex');

        clearError();
    };

    // Open modal
    addCommercialNameBtn.addEventListener('click', () => {
        newCommercialName.value = '';
        clearError();

        commercialNameModal.classList.remove('hidden');
        commercialNameModal.classList.add('flex');

        newCommercialName.focus();
    });

    // Close modal
    cancelCommercialNameBtn.addEventListener(
        'click',
        closeModal
    );

    closeCommercialNameModalBtn?.addEventListener(
        'click',
        closeModal
    );

    commercialNameModal.addEventListener('click', event => {
        if (event.target === commercialNameModal) {
            closeModal();
        }
    });

    // Close with Escape
    document.addEventListener('keydown', event => {
        if (
            event.key === 'Escape' &&
            !commercialNameModal.classList.contains('hidden')
        ) {
            closeModal();
        }
    });

    // Clear validation error when typing
    newCommercialName.addEventListener('input', clearError);

    // Save Commercial Name
    saveCommercialNameBtn.addEventListener(
        'click',
        async () => {
            const name = newCommercialName.value.trim();

            if (!name) {
                commercialNameError.textContent =
                    'نام تجاری الزامی است.';

                commercialNameError.classList.remove('hidden');
                newCommercialName.focus();

                return;
            }

            // Check for duplicates in the current list
            const duplicate = Array.from(
                commercialNameSelect.options
            ).some(option =>
                option.value !== '' &&
                option.textContent.trim().toLocaleLowerCase() ===
                    name.toLocaleLowerCase()
            );

            if (duplicate) {
                commercialNameError.textContent =
                    'این نام تجاری قبلاً در فهرست وجود دارد.';

                commercialNameError.classList.remove('hidden');
                newCommercialName.focus();

                return;
            }

            // Get antiforgery token
            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            )?.value;

            if (!token) {
                commercialNameError.textContent =
                    'توکن امنیتی فرم پیدا نشد.';

                commercialNameError.classList.remove('hidden');

                return;
            }

            const formData = new FormData();

            formData.append('name', name);
            formData.append(
                '__RequestVerificationToken',
                token
            );

            saveCommercialNameBtn.disabled = true;

            try {
                const response = await fetch(
                    '@Url.Action("AddCommercialName", "Lookup", new { area = "Seller" })',
                    {
                        method: 'POST',
                        body: formData
                    }
                );

                const result = await response.json();

                if (!response.ok || !result.success) {
                    commercialNameError.textContent =
                        result.message ||
                        'افزودن نام تجاری انجام نشد.';

                    commercialNameError.classList.remove('hidden');
                    return;
                }

                // Add the new item and select it
                const option = new Option(
                    result.name,
                    result.id,
                    true,
                    true
                );

                commercialNameSelect.add(option);

                commercialNameSelect.dispatchEvent(
                    new Event('input', { bubbles: true })
                );

                commercialNameSelect.dispatchEvent(
                    new Event('change', { bubbles: true })
                );

                closeModal();
            }
            catch (error) {
                console.error(
                    'AddCommercialName error:',
                    error
                );

                commercialNameError.textContent =
                    'خطایی در ارتباط با سرور رخ داد.';

                commercialNameError.classList.remove('hidden');
            }
            finally {
                saveCommercialNameBtn.disabled = false;
            }
        }
    );
})();
        // Commercial Name Custom Dropdown
        (() => {
    const select =
        document.getElementById('commercialNameSelect');

    const dropdown =
        document.getElementById('commercialNameDropdown');

    const trigger =
        document.getElementById('commercialNameDropdownButton');

    const menu =
        document.getElementById('commercialNameDropdownMenu');

    const label =
        document.getElementById('commercialNameDropdownLabel');

    const arrow =
        document.getElementById('commercialNameDropdownArrow');

    const search =
        document.getElementById('commercialNameSearch');

    const optionsContainer =
        document.getElementById('commercialNameOptions');

    const noResults =
        document.getElementById('commercialNameNoResults');

    if (
        !select || !dropdown || !trigger || !menu ||
        !label || !search || !optionsContainer || !noResults
    ) {
        console.error(
            'عناصر منوی سفارشی نام تجاری پیدا نشدند.'
        );
        return;
    }

    const closeMenu = () => {
        menu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
        arrow.classList.remove('rotate-180');
    };

    const syncSelectedValue = () => {
        const selectedOption =
            select.options[select.selectedIndex];

        const hasValue =
            selectedOption && selectedOption.value !== '';

        label.textContent = hasValue
            ? selectedOption.textContent.trim()
            : 'انتخاب نام تجاری';

        trigger.classList.toggle('text-gray-400', !hasValue);
        trigger.classList.toggle('dark:text-gray-400', !hasValue);
        trigger.classList.toggle('text-gray-900', !!hasValue);
        trigger.classList.toggle('dark:text-white', !!hasValue);
    };

    const renderOptions = (query = '') => {
        const normalizedQuery =
            query.trim().toLocaleLowerCase();

        optionsContainer.replaceChildren();

        let visibleCount = 0;

        Array.from(select.options).forEach(option => {
            const name = option.textContent.trim();

            if (
                option.value !== '' &&
                !name.toLocaleLowerCase().includes(normalizedQuery)
            ) {
                return;
            }

            visibleCount++;

            const item = document.createElement('button');

            item.type = 'button';
            item.className =
                'flex w-full items-center justify-between gap-3 ' +
                'rounded-lg px-3 py-2.5 text-right text-sm ' +
                'text-gray-700 transition hover:bg-indigo-50 ' +
                'focus:bg-indigo-50 focus:outline-none ' +
                'dark:text-gray-200 dark:hover:bg-gray-700 ' +
                'dark:focus:bg-gray-700';

            const nameSpan = document.createElement('span');

            nameSpan.className = 'truncate';
            nameSpan.textContent = name;

            item.appendChild(nameSpan);

            if (option.value === select.value) {
                item.setAttribute('aria-selected', 'true');
                item.classList.add('bg-indigo-50', 'dark:bg-gray-700');

                const check = document.createElement('span');

                check.className =
                    'shrink-0 font-bold text-indigo-600 ' +
                    'dark:text-indigo-400';

                check.textContent = '✓';
                item.appendChild(check);
            } else {
                item.setAttribute('aria-selected', 'false');
            }

            item.addEventListener('click', () => {
                select.value = option.value;

                select.dispatchEvent(
                    new Event('input', { bubbles: true })
                );

                select.dispatchEvent(
                    new Event('change', { bubbles: true })
                );

                syncSelectedValue();
                closeMenu();

                search.value = '';
                renderOptions();

                trigger.focus({ preventScroll: true });
            });

            optionsContainer.appendChild(item);
        });

        noResults.classList.toggle('hidden', visibleCount > 0);
    };

    const openMenu = () => {
        menu.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        arrow.classList.add('rotate-180');

        renderOptions(search.value);
        search.focus({ preventScroll: true });
    };

    trigger.addEventListener('click', () => {
        if (menu.classList.contains('hidden')) {
            openMenu();
        } else {
            closeMenu();
        }
    });

    search.addEventListener('input', () => {
        renderOptions(search.value);
    });

    select.addEventListener('change', () => {
        syncSelectedValue();
        renderOptions(search.value);
    });

    document.addEventListener('click', event => {
        if (!dropdown.contains(event.target)) {
            closeMenu();
        }
    });

    document.addEventListener('keydown', event => {
        if (
            event.key === 'Escape' &&
            !menu.classList.contains('hidden')
        ) {
            closeMenu();
            trigger.focus({ preventScroll: true });
        }
    });

    // Refresh the dropdown when a new name is added to the select.
    new MutationObserver(() => {
        syncSelectedValue();
        renderOptions(search.value);
    }).observe(select, {
        childList: true
    });

    syncSelectedValue();
    renderOptions();
})();
