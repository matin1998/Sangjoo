                           focus:ring-indigo-300
                           dark:border-gray-600 dark:bg-gray-800
                           dark:text-white">

                                        <span id="mineDropdownLabel" class="truncate">
                                            انتخاب معدن
                                        </span>

                                        <svg id="mineDropdownArrow"
                                             class="h-5 w-5 shrink-0 transition-transform"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="m19 9-7 7-7-7">
                                            </path>
                                        </svg>
                                    </button>

                                    <!-- Dropdown menu: normal document flow -->
                                    <div id="mineDropdownMenu"
                                         class="hidden mt-3 w-full overflow-hidden
                        rounded-xl border-2 border-indigo-400
                        bg-white shadow-xl
                        dark:border-indigo-500 dark:bg-gray-800">

                                        <!-- Search -->
                                        <div class="border-b border-indigo-200 p-3
                            dark:border-indigo-700">
                                            <input type="search"
                                                   id="mineSearch"
                                                   autocomplete="off"
                                                   placeholder="جست‌وجوی معدن..."
