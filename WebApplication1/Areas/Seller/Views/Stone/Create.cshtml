                            </div>

                            <!-- Hidden inputs for model binding -->
                            <div id="applicationHiddenInputs"></div>

                            <span asp-validation-for="ApplicationIds"
                                  class="text-red-500 text-xs"></span>
                        </div>
                    </div>




                    <!-- Seller -->
                    <div class="bg-white rounded-2xl drop-shadow-lg p-6
                            dark:bg-custom-dark dark:border dark:border-gray-700">

                        <h2 class="font-black text-xl with-highlight
                               dark:text-gray-200 mb-6">

                            فروشنده

                        </h2>

                        <div class="flex items-center gap-3
                                bg-gray-50 dark:bg-gray-800
                                rounded-lg p-4">

                            <div class="w-10 h-10 rounded-full bg-primary/10
                                    flex items-center justify-center">

                                <svg class="w-5 h-5 text-primary"
                                     fill="none"
                                     stroke="currentColor"
                                     viewBox="0 0 24 24">

                                    <path stroke-linecap="round"
                                          stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M16 7a4 4 0 11-8 0
                                         4 4 0 018 0zM12 14a7
                                         7 0 00-7 7h14a7 7 0
                                         00-7-7z">
                                    </path>

                                </svg>

                            </div>

                            <div>

                                <p class="text-xs text-gray-500
                                      dark:text-gray-400">
                                    فروشنده فعلی
                                </p>

                                <p class="font-medium text-gray-900
                                      dark:text-white">
                                    حساب فروشنده شما
                                </p>

                            </div>

                        </div>

                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-3">
                            محصول به صورت خودکار به حساب فروشنده فعلی اختصاص داده می‌شود.
                        </p>

                    </div>

                </div>


                <!-- Images -->
                <div class="bg-white rounded-2xl drop-shadow-lg p-6
            dark:bg-custom-dark dark:border dark:border-gray-700">

                    <h2 class="font-black text-xl with-highlight
               dark:text-gray-200 mb-6">
                        تصاویر سنگ
                        <span class="text-red-500">*</span>
                    </h2>

                    <div class="border-2 border-dashed border-gray-300
                rounded-lg p-8 text-center
                dark:border-gray-600">

                        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M4 16l4.586-4.586a2 2 0
                     012.828 0L16 16m-2-2l1.586-1.586
                     a2 2 0 012.828 0L20 14m-6-6h.01
                     M6 20h12a2 2 0 002-2V6a2 2
                     0 00-2-2H6a2 2 0 00-2 2v12
                     a2 2 0 002 2z">
                            </path>
                        </svg>

                        <p class="text-gray-500 dark:text-gray-400 mb-4">
                            تصاویر سنگ را انتخاب کنید
                        </p>

                        <label class="inline-block bg-primary text-white
                      py-2 px-4 rounded-lg text-sm
                      hover:bg-primary-600 cursor-pointer
                      transition duration-200">

                            انتخاب تصاویر

                            <input asp-for="Images"
                                   id="Images"
                                   type="file"
                                   multiple
                                   accept="image/*"
                                   class="hidden">
                        </label>

                        <p class="text-xs text-gray-400 mt-3">
                            امکان انتخاب چند تصویر وجود دارد.
                        </p>

                    </div>

                    <!-- Image Previews -->
                    <div id="imagePreviewContainer" class="hidden mt-5">

                        <p class="text-sm font-semibold text-gray-700
                  dark:text-gray-200 mb-3">
                            تصاویر انتخاب‌شده
                        </p>

                        <div id="imagePreviewList"
                             class="flex flex-wrap gap-3">
                        </div>

                        <p id="imageCount"
                           class="text-xs text-gray-500 dark:text-gray-400 mt-3">
                        </p>

                    </div>

                    <span asp-validation-for="Images"
                          class="text-red-500 text-xs">
                    </span>

                </div>
                

            </div>

            

        </div>

    </form>

</div>
