@using Sangjoo.Application.DTOs.AdminSide.Sellers
@model CreateSellerDTO

<form asp-area="Admin"
      asp-controller="Seller"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div>
        <label>نام فروشنده</label>
        <input asp-for="SellerName" />
        <span asp-validation-for="SellerName"></span>
    </div>

    <div>
        <label>نام و نام خانوادگی</label>
        <input asp-for="FullName" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div>
        <label>ایمیل</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label>شماره موبایل</label>
        <input asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber"></span>
    </div>

    <div>
        <label>رمز عبور</label>
        <input asp-for="Password"
               type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="flex items-center gap-2">
        <input type="checkbox"
               id="IsActive"
               name="IsActive"
               value="true"
               checked
               class="w-4 h-4">

        <label for="IsActive">
            فعال
        </label>
    </div>

    <button type="submit">
        ایجاد فروشنده
    </button>

</form>
